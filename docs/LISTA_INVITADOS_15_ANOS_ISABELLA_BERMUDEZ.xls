   <Interior ss:Color="#FFFFFF" ss:Pattern="Solid"/>
  </Style>
  <Style ss:ID="RowGrupal">
   <Alignment ss:Vertical="Center"/>
   <Interior ss:Color="#F4F7F2" ss:Pattern="Solid"/>
  </Style>
  <Style ss:ID="CenterCell">
